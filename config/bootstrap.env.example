# bootstrap.env — pas aan vóór de eerste run
# Kopieer config/bootstrap.env.example naar config/bootstrap.env en vul in.
# Dit bestand wordt gesourced door alle WSL-scripts.

# ── Identiteit ────────────────────────────────────────────────────────────────
# Volledige naam voor git config en Obsidian
BOOTSTRAP_USER_FULLNAME="Your Name"

# E-mailadres voor git config en Obsidian
BOOTSTRAP_USER_EMAIL="you@example.com"

# Git-gebruikersnaam (voor Obsidian vault commits)
BOOTSTRAP_GIT_USERNAME="yourusername"

# ── Machine ───────────────────────────────────────────────────────────────────
# Hostnaam van de Windows-machine (gebruikt door 00-set-hostname.ps1)
BOOTSTRAP_HOSTNAME="ai-workstation"

# Windows-gebruikersnaam (voor paden als /mnt/c/Users/<naam>/...)
# Laat leeg om automatisch af te leiden via wslvar of $USER
BOOTSTRAP_WINDOWS_USER=""

# ── Honcho / Hermes ───────────────────────────────────────────────────────────
# Naam van de menselijke gebruiker in het Honcho-geheugen
BOOTSTRAP_HONCHO_PEER_NAME="${USER}"

# Naam van de AI-assistent
BOOTSTRAP_HONCHO_AI_PEER="atlas"

# Honcho workspace-naam
BOOTSTRAP_HONCHO_WORKSPACE="default"

# ── Obsidian ──────────────────────────────────────────────────────────────────
# Subdirectory onder /mnt/c/Users/<BOOTSTRAP_WINDOWS_USER>/ voor de vault
BOOTSTRAP_OBSIDIAN_VAULT_SUBDIR="AI-Workspace"

# ── Organisatie ───────────────────────────────────────────────────────────────
BOOTSTRAP_COMPANY_NAME="Your Company"

# ── Gitea (optioneel) ─────────────────────────────────────────────────────────
# Vul in als je een zelf-gehoste Gitea gebruikt. Laat leeg bij GitHub-only.
BOOTSTRAP_GITEA_HOST=""

# ── Zelf-gehoste diensten (optioneel) ────────────────────────────────────────
# Vikunja taakmanager: hostname:poort (bijv. "nas.local:3456")
BOOTSTRAP_VIKUNJA_HOST=""

# Outline wiki: volledige URL (bijv. "http://192.168.1.10:3001")
BOOTSTRAP_OUTLINE_URL=""

# Matrix room ID voor Hermes (bijv. "!roomid:matrix.example.org")
BOOTSTRAP_MATRIX_ROOM_ID=""

# NAS hostname (bijv. "nas.local" of "192.168.1.20")
BOOTSTRAP_NAS_HOST=""
